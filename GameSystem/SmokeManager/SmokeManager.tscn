[ext_resource type="Script" path="res://GameSystem/SmokeManager/SmokeManager.gd" id="1_manager"]

[sub_resource type="Shader" id="Shader_smoke_group"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform sampler2D color_ramp;
uniform float threshold : hint_range(0.0, 1.0) = 0.5;
uniform float smoothness : hint_range(0.0, 0.1) = 0.05;

void fragment() {
    vec4 screen_color = texture(screen_texture, SCREEN_UV);
    float density = screen_color.a;
    vec4 remapped_color = texture(color_ramp, vec2(density, 0.5));
    float mask = smoothstep(threshold - smoothness, threshold + smoothness, density);
    COLOR = vec4(remapped_color.rgb, remapped_color.a * mask);
}"

